# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Box configuration is non-secret by design: instance type, AMI, sizes. Every
# secret the box holds comes from SSM Parameter Store at run time and none of
# it passes through OpenTofu, so these files are safe to commit.
!terraform.tfvars

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Providers cached between `tofu init` runs (TF_PLUGIN_CACHE_DIR in CI).
.tofu-plugin-cache/

# Run output and credentials. Nothing from a run's raw/ directory is ever
# committed; these catch the common shapes before review has to.
raw/
*.tar.zst
.env

# A local run's box.conf and scratch files (docs/runner.md, "Local run").
local/
