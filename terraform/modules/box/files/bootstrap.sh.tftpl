#!/bin/bash
# First-boot bootstrap of a forge-perf box. cloud-init runs it once, as root,
# on the first boot of each instance. It clones this repository, writes
# box.conf and hands off to update.sh --local, which runs provision.sh, records
# the commit it provisioned and enables the mode's units. The marker at the end
# is written only when every step passed.
set -euo pipefail
exec > >(tee -a /var/log/forge-perf-bootstrap.log) 2>&1
%{ if expire_calendar != "" ~}

# A box with an ExpiresAt powers itself off then, whatever happens after this
# point: a persistent timer survives reboots and fires at boot once the time
# has passed, so a failed bootstrap or recovery still stops the box.
cat >/etc/systemd/system/forge-perf-expire.service <<'UNIT'
[Unit]
Description=Power off the box at its ExpiresAt time

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl poweroff
UNIT
cat >/etc/systemd/system/forge-perf-expire.timer <<'UNIT'
[Unit]
Description=Power off the box at its ExpiresAt time

[Timer]
OnCalendar=${expire_calendar} UTC
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now forge-perf-expire.timer
%{ endif ~}

CHECKOUT=/opt/forge-perf
REF='${ref}'

export DEBIAN_FRONTEND=noninteractive
# The Ubuntu server image ships git, curl and ca-certificates, so apt runs only
# on an image without them. An apt-daily run may hold apt's locks this early.
# install waits for the dpkg lock through DPkg::Lock::Timeout; update takes the
# lists lock, which that option does not cover, so it retries for 5 minutes.
if ! command -v git >/dev/null || ! command -v curl >/dev/null; then
  tries=0
  until apt-get update -q; do
    tries=$((tries + 1))
    [ "$tries" -lt 30 ] || exit 1
    sleep 10
  done
  apt-get -o DPkg::Lock::Timeout=300 install -y -q ca-certificates curl git
fi

if [ ! -d "$CHECKOUT/.git" ]; then
  git clone --no-checkout '${repository_url}' "$CHECKOUT"
fi
# A branch is on origin/; a full commit is not.
git -C "$CHECKOUT" checkout --quiet --detach "origin/$REF" 2>/dev/null ||
  git -C "$CHECKOUT" checkout --quiet --detach "$REF"

# Everything per box that is not in the checkout. The instance type is not
# here: the host reads it from instance metadata, so a resize changes nothing
# in this file.
install -d -m 0755 /etc/forge-perf
cat >/etc/forge-perf/box.conf <<'CONF'
FORGE_PERF_BOX_ID=${box_id}
FORGE_PERF_MODE=${mode}
FORGE_PERF_CHECKOUT=/opt/forge-perf
FORGE_PERF_REF=${ref}
FORGE_PERF_REGION=${region}
FORGE_PERF_RESULTS_BUCKET=${results_bucket}
FORGE_PERF_PIRI_BUCKET_PREFIX=${piri_bucket_prefix}
FORGE_PERF_SMELT_BUCKET_PREFIX=${smelt_bucket_prefix}
FORGE_PERF_SSM_PATH=${ssm_path}
CONF

"$CHECKOUT/scripts/host/update.sh" --local

date -Is >/etc/forge-perf/bootstrap-complete
%{ if campaign_json != "" ~}

# A campaign box: what to run, then the unit that runs it. Enabled units start
# at the next boot, so this boot starts it here.
cat >/etc/forge-perf/campaign.json <<'CAMPAIGN'
${campaign_json}
CAMPAIGN
systemctl start --no-block forge-perf-campaign.service
%{ endif ~}
