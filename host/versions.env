# Every tool the box installs, pinned. Sourced by scripts/host/provision.sh and
# install-tools.sh. A bump is a pull request: the next provision.sh applies it
# between runs, and the run record shows the change.

# Checked against the host's architecture before anything is downloaded.
TARGET_PLATFORM=linux_arm64

# Docker's apt repository for noble, which keeps every release, so a replaced
# box installs the same engine. Exact strings from `apt-cache madison`.
DOCKER_CE_VERSION=5:29.8.1-1~ubuntu.24.04~noble
CONTAINERD_VERSION=2.3.6-1~ubuntu.24.04~noble
COMPOSE_PLUGIN_VERSION=5.5.1-1~ubuntu.24.04~noble
# Primary key fingerprint of https://download.docker.com/linux/ubuntu/gpg.
DOCKER_APT_KEY_FPR=9DC858229FC7DD38854AE2D88D81803C0EBFCD88

# From https://go.dev/dl/?mode=json. The harness needs go >= 1.26.0; runs set
# GOTOOLCHAIN=local, so a newer go line fails the build instead of downloading.
GO_VERSION=1.26.8
GO_SHA256=211ffced9dcb9633a55eac6364816ec0ddd951389a740e88fa8b3337971bdda0

# infra-nodes dev's pin, from ucantool_<version>_checksums.txt on the release.
# Installed so smelt's init.sh finds it and never runs `go install @latest`.
UCANTOOL_VERSION=v0.1.0
UCANTOOL_SHA256=d2bdcc84a7b327e2d713c3d985d2aac2b9ed09508933c3e925e08ae6286f02cf

# awscli-exe-linux-aarch64-<version>.zip; AWS publishes a signature but no
# checksum, so this one was computed from the download.
AWSCLI_VERSION=2.37.4
AWSCLI_SHA256=869aa72b9bdb931a9158d0cea9f4f0dc3f7aecf24ea1552da549b87907d28ab2

# Not pinned. Those the AMI lacks (make, fio, nvme-cli and unzip among them)
# install at the version noble-updates carries on the day the box is built, so
# two boxes can differ; box-facts.sh records every one's version with each run.
# The AMI's own time daemon stays the clock source: installing chrony would
# remove systemd-timesyncd.
ARCHIVE_PACKAGES="ca-certificates curl git gnupg jq make python3 fio zstd nvme-cli iproute2 ethtool unzip sysstat"
