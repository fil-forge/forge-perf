# Drill settings for an m9gd.16xlarge box (tier 3). run.sh reads the file named
# after the instance type in instance metadata, so a box of a type without a
# file stops runs. Every value is part of the instrument and lands in the run
# record. docs/DESIGN.md §4 gives the reasons for each.

BOX_TIER=3
# 34 Gbps, the type's baseline network bandwidth, in bytes per second.
BASELINE_BYTES_PER_S=4250000000

# --stop-ingest-at and --duration per kind of run (GB = 10^9 bytes). Tier 3
# runs only campaigns, which give their own size; these match campaign.yml's
# default. 2,000 GB needs 2,500 GB of the 3,800 GB drive and gives about 22
# windows at 3 GB/s.
TRIGGER_SIZE=2000GB
TRIGGER_DURATION=2h
NIGHTLY_SIZE=2000GB
NIGHTLY_DURATION=4h

# Tier 2's value, so the two tiers compare at the same number of parallel
# uploads. A campaign sweeps other values with its workers input.
WORKERS=64

# smelt's scripts/perf-drill.sh variables, one per drill flag.
WINDOW=30s
RAMP=10s
VERIFY_LAG_MIN=30s
VERIFY_LAG_MAX=60s
RATE_TARGET=6GB
ACCOUNTS=64
RESTORE_SCALE=0.25
PROGRESS=30s
ENFORCE_FLOOR=false
KEEP_OBJECTS=1
DISK_FACTOR=1.25

# The share of requests a run traces, a decimal in (0, 1]; empty runs no
# collector and traces nothing (docs/runner.md, "Tracing"). A 2,000 GB run at
# a tenth writes about 1.8 GB of spans.
TRACE_RATIO=0.1
