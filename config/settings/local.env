# Drill settings for a local run (docs/runner.md, "Local run"). In skip mode
# instance metadata reports the type as "local", which selects this file.
# Small sizes, so a laptop finishes a run in minutes.

BOX_TIER=1
BASELINE_BYTES_PER_S=

TRIGGER_SIZE=2GB
TRIGGER_DURATION=10m
NIGHTLY_SIZE=5GB
NIGHTLY_DURATION=15m

WORKERS=4

WINDOW=10s
RAMP=10s
VERIFY_LAG_MIN=30s
VERIFY_LAG_MAX=60s
RATE_TARGET=6GB
ACCOUNTS=64
RESTORE_SCALE=0.25
PROGRESS=30s
ENFORCE_FLOOR=false
KEEP_OBJECTS=1
DISK_FACTOR=1.25
