# Drill settings for a local run (docs/runner.md, "Local run"). In skip mode
# instance metadata reports the type as "local", which selects this file.
# Small sizes, so a laptop finishes a run in minutes.

BOX_TIER=1
BASELINE_BYTES_PER_S=

TRIGGER_SIZE=2GB
TRIGGER_DURATION=10m
NIGHTLY_SIZE=5GB
NIGHTLY_DURATION=15m

WORKERS=4

WINDOW=10s
RAMP=10s
VERIFY_LAG_MIN=30s
VERIFY_LAG_MAX=60s
RATE_TARGET=6GB
ACCOUNTS=64
RESTORE_SCALE=0.25
PROGRESS=30s
ENFORCE_FLOOR=false
KEEP_OBJECTS=1
# The box's factor: smelt's disk check covers ingot's spool, Postgres and logs.
# The local MinIO keeps piri's blobs on the same laptop disk, so a laptop needs
# about twice the cap free (docs/runner.md, "Local run").
DISK_FACTOR=1.25

# The share of requests a run traces, a decimal in (0, 1]; empty runs no
# collector and traces nothing (docs/runner.md, "Tracing").
TRACE_RATIO=

# Ingot's local blob budget (its local_blob_max_bytes), in GB like the sizes
# above: ingot evicts cached bodies to keep its spool and cache under it.
# Empty runs ingot without a budget (docs/runner.md, "Ingot's local blob
# budget").
LOCAL_BLOB_BUDGET=
