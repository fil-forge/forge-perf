# Drill settings for an m9gd.8xlarge box (tier 2). run.sh reads the file named
# after the instance type in instance metadata, so a resize without a file for
# the new type stops runs. Every value is part of the instrument and lands in
# the run record. docs/DESIGN.md §4 gives the reasons for each.

BOX_TIER=2
# 17 Gbps, the type's baseline network bandwidth, in bytes per second.
BASELINE_BYTES_PER_S=2125000000

# --stop-ingest-at and --duration per kind of run (GB = 10^9 bytes). At about
# 2 GB/s a trigger run scores about 8 windows and a nightly about 20.
TRIGGER_SIZE=500GB
TRIGGER_DURATION=1h
NIGHTLY_SIZE=1200GB
NIGHTLY_DURATION=4h

# Frozen by the calibration sweep. run.sh refuses to start while it is empty
# and no --workers is given.
WORKERS=

# smelt's scripts/perf-drill.sh variables, one per drill flag.
WINDOW=30s
RAMP=10s
VERIFY_LAG_MIN=30s
VERIFY_LAG_MAX=60s
RATE_TARGET=6GB
ACCOUNTS=64
RESTORE_SCALE=0.25
PROGRESS=30s
ENFORCE_FLOOR=false
KEEP_OBJECTS=1
DISK_FACTOR=1.25
