# Drill settings for an m9gd.8xlarge box (tier 2). run.sh reads the file named
# after the instance type in instance metadata, so a resize without a file for
# the new type stops runs. Every value is part of the instrument and lands in
# the run record. docs/DESIGN.md §4 gives the reasons for each.

BOX_TIER=2
# 17 Gbps, the type's baseline network bandwidth, in bytes per second.
BASELINE_BYTES_PER_S=2125000000

# --stop-ingest-at and --duration per kind of run (GB = 10^9 bytes). At 64
# workers a trigger run scored 14 to 15 windows in the sweep; a nightly scores
# about 40.
TRIGGER_SIZE=500GB
TRIGGER_DURATION=1h
NIGHTLY_SIZE=1200GB
NIGHTLY_DURATION=4h

# The sweep (calibration/workers/2026-09-28-m9gd.8xlarge.json) levels off at
# 256 workers. 64 is a realistic number of parallel uploads, so the tracked
# rate follows the per-object path rather than what concurrency can hide.
WORKERS=64

# smelt's scripts/perf-drill.sh variables, one per drill flag.
WINDOW=30s
RAMP=10s
VERIFY_LAG_MIN=30s
VERIFY_LAG_MAX=60s
RATE_TARGET=6GB
ACCOUNTS=64
RESTORE_SCALE=0.25
PROGRESS=30s
ENFORCE_FLOOR=false
KEEP_OBJECTS=1
DISK_FACTOR=1.25

# The share of requests a run traces, a decimal in (0, 1]; empty runs no
# collector and traces nothing (docs/runner.md, "Tracing"). Every run traces
# a tenth of its requests: about 0.45 GB of spans for a trigger run and 1.1 GB
# for a nightly. run.sh --trace 0 or campaign.sh --trace 0 runs one untraced.
TRACE_RATIO=0.1

# Ingot's local blob budget (its local_blob_max_bytes), in GB like the sizes
# above: ingot evicts cached bodies to keep its spool and cache under it.
# Empty runs ingot without a budget (docs/runner.md, "Ingot's local blob
# budget").
LOCAL_BLOB_BUDGET=
