# Simulated latency between the node group and the central group, read by
# scripts/host/netem.sh. These values are part of the instrument: every run
# records them, and a change here changes what the numbers mean.

# Round trip added to every exchange across the node/central boundary, in ms.
RTT_MS=25
# A measured round trip across the boundary must fall within this percentage
# of RTT_MS (22.5 to 27.5 ms at 25 ms and 10%).
RTT_TOLERANCE_PCT=10
# The run creates forge-network with this subnet. Every shaped container and
# filter target must hold an address inside it.
NET_SUBNET=172.30.0.0/24
