# Paths that cannot change a measurement, left out of the instrument tree hash
# (provenance.forge_perf.instrument_tree, docs/record.md). One path prefix per
# line, surrounding whitespace stripped, compared as a plain string against
# each path from `git ls-tree -r --full-tree HEAD`; a line ending in / names a
# directory. Blank lines and lines starting with # are skipped.
#
# Everything not listed here is instrument, including any new top-level
# directory: an unlisted path marks a run as an instrument change, which is
# the safe mistake. Add a path here only when the box does not read it while
# it measures.

.github/
.gitignore
AGENTS.md
CLAUDE.md
LICENSE
Makefile
README.md
calibration/
# The ceiling tool runs only on a calibration box, never during a run.
cmd/s3-ceiling/
# The Grafana step reads these only after the record is written.
config/grafana-span-attributes.txt
config/grafana.conf
config/otel-grafana.yaml
data/
docs/
# go.mod and go.sum belong here only while no Go code runs during a run.
go.mod
go.sum
schema/
scripts/ci/
scripts/host/ceiling
scripts/host/fixtures/
scripts/host/test_
scripts/host/tests/
scripts/operator/
scripts/publish/
site/
terraform/
