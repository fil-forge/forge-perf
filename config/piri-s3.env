# Where piri keeps its blobs, and how the host reaches the same buckets. The
# box points piri at AWS S3 and empties the buckets with its instance role; a
# local run points both at a MinIO. Each line is a default: a value set in
# /etc/forge-perf/box.conf or the environment wins.

# host:port piri dials, as smelt's manifest takes it (storage.s3.endpoint).
: "${FORGE_PERF_PIRI_S3_ENDPOINT:=s3.us-east-2.amazonaws.com}"
# true: plain HTTP, for a local MinIO without TLS (storage.s3.insecure).
: "${FORGE_PERF_PIRI_S3_INSECURE:=false}"
: "${FORGE_PERF_PIRI_S3_REGION:=us-east-2}"
# The URL the host uses when it reaches the store at another address than
# piri does (piri dials a container name, the laptop dials localhost). Empty:
# http(s)://<endpoint>.
: "${FORGE_PERF_PIRI_S3_HOST_URL:=}"
# A PEM bundle the host trusts for the endpoint. Empty: the system store.
: "${FORGE_PERF_PIRI_S3_CA_BUNDLE:=}"
# role: the host's own credential chain (the instance role on the box).
# key: FORGE_PERF_PIRI_S3_KEY_ID and FORGE_PERF_PIRI_S3_SECRET from the file
# below, which also feeds piri itself.
: "${FORGE_PERF_PIRI_S3_HOST_AUTH:=role}"
: "${FORGE_PERF_PIRI_S3_CREDENTIALS:=${FORGE_PERF_RUNTIME:-/run/forge-perf}/secrets/piri-s3.env}"
